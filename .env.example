# Copy this file to .env.local and fill in values as they become available.
# Nothing here is required for local development — all forms run in a
# documented demonstration mode until these are configured. See README.md.

# --- Site ---
# Overrides content/site-settings.ts siteConfig.domain if set.
# NEXT_PUBLIC_SITE_URL=https://www.kupandacollective.org

# --- Form notifications (lib/notify.ts) ---
# Option A: point at any webhook/automation endpoint (e.g. Zapier, Make,
# a serverless function) that accepts a JSON POST.
# FORM_NOTIFY_WEBHOOK_URL=

# Option B: a transactional email provider API key (wire up in lib/notify.ts).
# RESEND_API_KEY=

# --- Newsletter provider ---
# Not yet wired to a specific provider. See README.md "Configure newsletter
# sign-up" for how to connect Mailchimp/Buttondown/ConvertKit via
# app/api/newsletter/route.ts.
# NEWSLETTER_API_KEY=
# NEWSLETTER_AUDIENCE_ID=

# --- Analytics (privacy-conscious, disabled until configured) ---
# NEXT_PUBLIC_ANALYTICS_ID=
